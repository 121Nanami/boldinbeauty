# Copy to .env for local runs, or set these in your host's dashboard. NEVER commit a real .env.

PORT=8080

# --- Database: your MongoDB Atlas connection string (Database > Connect > Drivers).
# Put the database user's password in the string. Do not commit it.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=boldinbeauty

# --- Secret used to hash e-mail codes. At least 32 characters: openssl rand -hex 32
CODE_SECRET=

# --- The owner/admin account: the e-mail(s) that get the admin flag (comma separated).
ADMIN_EMAILS=admin@example.com

# --- E-mail. Pick ONE provider.
MAIL_PROVIDER=smtp
MAIL_FROM="Boldinbeauty <no-reply@your-domain.example>"
# smtp: any SMTP service (the provider shows you these values)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
# resend: https://resend.com (needs a verified sending domain)
# MAIL_PROVIDER=resend
# RESEND_API_KEY=

# --- Behind a host's load balancer (Render, Fly, Railway, Cloud Run...) set the number of proxy hops so rate limits
# see the real client address. 0 = trust nothing.
TRUST_PROXY_HOPS=1

# Optional tuning
# CODE_MINUTES=10
# SESSION_DAYS=30
# IP_RATE_LIMIT_PER_MINUTE=120
